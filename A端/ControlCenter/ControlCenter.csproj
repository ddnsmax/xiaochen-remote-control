<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ControlCenter</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>3.0.0</Version>
    <FileVersion>3.0.0.0</FileVersion>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <InformationalVersion>3.0-rustdesk-remote-core</InformationalVersion>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="..\..\ThirdParty\RustDesk\RustDeskRuntime.zip"
                      LogicalName="ControlCenter.RustDeskRuntime.zip" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <ProjectReference Include="..\..\Shared\RemoteControl.Shared\RemoteControl.Shared.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(AgentTemplatePath)' != ''">
    <EmbeddedResource Include="$(AgentTemplatePath)"
                      LogicalName="ControlCenter.AgentTemplate.bin" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="VirtualFileDataObject" Version="1.0.0" />
  </ItemGroup>
</Project>

