<Window x:Class="ControlCenter.ServiceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务属性" Width="700" Height="600" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
    <Border Grid.Row="1" Background="White" BorderBrush="#D8DEE9" BorderThickness="1"
            CornerRadius="10" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="服务名称" FontWeight="SemiBold"/><TextBlock x:Name="NameText" Grid.Column="1" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Text="显示名称" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="DisplayNameText" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Text="状态" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="StatusValue" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0"/>
          <TextBlock Grid.Row="3" Text="启动类型" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="StartTypeValue" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0"/>
          <TextBlock Grid.Row="4" Text="进程ID" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="PidText" Grid.Row="4" Grid.Column="1" Margin="0,12,0,0"/>
          <TextBlock Grid.Row="5" Text="登录账户" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="AccountText" Grid.Row="5" Grid.Column="1" Margin="0,12,0,0" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Text="可执行文件" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="PathText" Grid.Row="6" Grid.Column="1" Margin="0,12,0,0" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Text="描述" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="DescriptionText" Grid.Row="7" Grid.Column="1" Margin="0,12,0,0" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="8" Text="依赖服务" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="DependenciesText" Grid.Row="8" Grid.Column="1" Margin="0,12,0,0" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="9" Text="被依赖服务" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="DependentsText" Grid.Row="9" Grid.Column="1" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </Grid>
      </ScrollViewer>
    </Border>
    <Button Grid.Row="2" Content="关闭" Width="96" Height="36" Margin="0,14,0,0"
            HorizontalAlignment="Right" IsDefault="True" Click="Close_Click"/>
  </Grid>
</Window>
