<Window x:Class="ControlCenter.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430"
        Height="210"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FB">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="TitleText"
               FontFamily="Microsoft YaHei UI"
               FontSize="20"
               FontWeight="SemiBold"
               Foreground="#182033"/>
    <TextBlock x:Name="MessageText"
               Grid.Row="1"
               Margin="0,14,0,14"
               FontFamily="Microsoft YaHei UI"
               FontSize="14"
               Foreground="#536078"
               TextWrapping="Wrap"/>
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Width="88"
              Height="34"
              Margin="0,0,10,0"
              Content="确定"
              IsDefault="True"
              Click="Confirm_Click"/>
      <Button Width="88"
              Height="34"
              Content="取消"
              IsCancel="True"
              Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
