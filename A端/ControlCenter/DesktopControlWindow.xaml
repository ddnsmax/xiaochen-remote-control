<Window x:Class="ControlCenter.DesktopControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面控制" Width="1280" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#090B10" SizeToContent="Manual"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed" Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="30"/>
    </Grid.RowDefinitions>

    <Border Background="#141923" BorderBrush="#252D3B" BorderThickness="0,0,0,1">
      <DockPanel Margin="10,6">
        <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <CheckBox x:Name="ControlBox" Content="允许控制" Foreground="#D9E2F2" IsChecked="True"
                    VerticalAlignment="Center" Margin="0,0,14,0"
                    Checked="ControlBox_Changed" Unchecked="ControlBox_Changed"/>
          <Button Content="诊断/刷新" Width="90" Margin="4,0" Click="RefreshFrame_Click"/>
          <Button Content="适应窗口" Width="82" Margin="4,0" Click="Fit_Click"/>
          <Button Content="原始大小" Width="82" Margin="4,0" Click="Original_Click"/>
          <Button x:Name="FullButton" Content="全屏" Width="70" Margin="4,0" Click="FullScreen_Click"/>
          <Button x:Name="AudioButton" Content="获取音频" Width="82" Margin="4,0" Click="Audio_Click"/>
          <Button Content="关闭" Width="70" Margin="4,0" Click="Close_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border x:Name="Surface" Grid.Row="1" Background="#050608" Focusable="True" ClipToBounds="True"
            SizeChanged="Surface_SizeChanged"
            PreviewMouseMove="RemoteSurface_MouseMove"
            PreviewMouseLeftButtonDown="RemoteSurface_MouseLeftButtonDown"
            PreviewMouseLeftButtonUp="RemoteSurface_MouseLeftButtonUp"
            PreviewMouseRightButtonDown="RemoteSurface_MouseRightButtonDown"
            PreviewMouseRightButtonUp="RemoteSurface_MouseRightButtonUp"
            PreviewMouseWheel="RemoteSurface_MouseWheel"
            LostMouseCapture="Surface_LostMouseCapture">
      <Grid>
        <ScrollViewer x:Name="DesktopScroller"
                      Background="#050608"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center">
          <Grid x:Name="ImageHost" Background="#050608">
            <Image x:Name="RemoteImage" Stretch="Uniform" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   IsHitTestVisible="False"/>
          </Grid>
        </ScrollViewer>
        <Border x:Name="NoFrameOverlay" Background="#CC050608" Visibility="Visible" IsHitTestVisible="False">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="正在获取远程桌面画面…" Foreground="White" FontSize="20"
                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DiagnosticText" Text="等待实时视频流首帧" Foreground="#A8B0BF"
                       Margin="0,10,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <StatusBar Grid.Row="2" Background="#111722" Foreground="#B8C0CC">
      <StatusBarItem x:Name="StatusText" Content="准备连接桌面视频流"/>
    </StatusBar>
  </Grid>
</Window>
