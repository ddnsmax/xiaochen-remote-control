<Window x:Class="ControlCenter.AgentGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="生成被控端"
        Width="520"
        Height="245"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="生成被控端" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1"
               Margin="0,8,0,12"
               Foreground="#667085"
               Text="输入域名并先保存，再生成使用该域名连接A端的B端程序。端口固定为 27183。"/>
    <TextBox x:Name="DomainBox"
             Grid.Row="2"
             Height="34"
             Padding="9,6"
             VerticalContentAlignment="Center"
             TextChanged="DomainBox_TextChanged"/>
    <TextBlock x:Name="StatusText"
               Grid.Row="3"
               Margin="0,9,0,0"
               Foreground="#667085"
               TextWrapping="Wrap"/>

    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Width="86" Height="32" Margin="0,0,8,0"
              Content="取消" Click="Cancel_Click"/>
      <Button Width="86" Height="32" Margin="0,0,8,0"
              Content="保存" Click="Save_Click"/>
      <Button x:Name="GenerateButton"
              Width="96" Height="32"
              Content="生成被控端"
              IsEnabled="False"
              Click="Generate_Click"/>
    </StackPanel>
  </Grid>
</Window>
