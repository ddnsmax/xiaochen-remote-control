<Window x:Class="ControlCenter.RegistryValueEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑注册表值" Width="620" Height="470"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14"
        Background="#F5F7FA">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="数值名称" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBox x:Name="NameBox" Grid.Row="1" Height="38" Padding="9,0"
             VerticalContentAlignment="Center"/>

    <Grid Grid.Row="2" Margin="0,14,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="数值类型" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="TypeBox" Height="38"
                  VerticalContentAlignment="Center"
                  SelectionChanged="TypeBox_SelectionChanged">
          <ComboBoxItem Content="字符串值" Tag="String"/>
          <ComboBoxItem Content="可扩充字符串值" Tag="ExpandString"/>
          <ComboBoxItem Content="多字符串值" Tag="MultiString"/>
          <ComboBoxItem Content="二进制值" Tag="Binary"/>
          <ComboBoxItem Content="无类型值" Tag="None"/>
          <ComboBoxItem Content="DWORD（32位）值" Tag="DWord"/>
          <ComboBoxItem Content="QWORD（64位）值" Tag="QWord"/>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="16,0,0,0">
        <TextBlock Text="输入格式" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock x:Name="FormatHint" Height="38" Padding="9,0"
                   VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="#475569"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" Background="White" BorderBrush="#CBD5E1"
            BorderThickness="1" CornerRadius="6">
      <TextBox x:Name="DataBox" Padding="10" BorderThickness="0"
               AcceptsReturn="True" AcceptsTab="True"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               FontFamily="Consolas" FontSize="15"/>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="确定" Width="92" Height="38" IsDefault="True"
              Click="Ok_Click"/>
      <Button Content="取消" Width="92" Height="38" Margin="10,0,0,0"
              IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
